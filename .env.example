# Serpstat API (база g_ua): семантика, топ видачі, видимість доменів.
# Токен: кабінет Serpstat -> API. Без нього не працюють скіли з даними Serpstat.
SERPSTAT_TOKEN=

# DataForSEO, необов'язково: живий SERP із тайтлами і частотності поза Україною.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# SerpApi, необов'язково: замір AI Overviews у скілі aio-monitoring.
SERPAPI_KEY=

# PageSpeed Insights API, безкоштовно (Google Cloud): блок швидкості в tech-audit.
PAGESPEED_API_KEY=
